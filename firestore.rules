rules_version = '2';
// Gym Tracker uses Supabase Auth/Postgres, not Firebase Auth/Firestore.
// Keep an unused Firestore database inaccessible. Do not publish over another app's rules.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
